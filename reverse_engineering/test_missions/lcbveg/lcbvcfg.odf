[Vegetation]

// single  - one patch centred on the player.
// ladder  - `steps` patches ahead of the player, density stepping
//           geometrically from densityMin to densityMax, so one screenshot
//           shows the whole usable range instead of one guess from it.
// off     - no clutter. The control: what Achilles looks like bare.
scenario = "ladder"

// closeup is the diagnostic: three fat patches at arm's length, lifted 0.02, 3
// and 10 units above the terrain height the engine reports, with no terrain
// filter. If none appear, the problem is the material or the render path; if
// the lifted ones appear and the flush one does not, the sampled height is not
// the datum the terrain renders at.
closeupScale = 3.0

// Supplied by Campaign Reimagined. The mission logs a clear refusal and
// carries on if they are not loaded, rather than failing to start.
mesh = "crgrass.mesh"
material = "CR/GrassPrototype"

// --- single -----------------------------------------------------------------
radius = 45.0
density = 0.35
seed = 1001

// --- ladder -----------------------------------------------------------------
steps = 5
densityMin = 0.05
densityMax = 0.80
stepRadius = 30.0
stepSpacing = 85.0
firstDistance = 70.0

// --- terrain type filtering ------------------------------------------------
// Achilles numbers its materials 0 grass, 1 trees, 2 rocky rock, 3 river,
// 4 waterfall, 5 base. With this on, a blade is only placed where the .mat
// says the ground is one of terrainTypes -- so grass stays out of the river
// and off the rock. Turn it off to see what slope-only placement does.
restrictToTerrainTypes = 1
// Achilles type 1 is WOODED ground, not tree geometry -- grass belongs on it
// just as much as on type 0. Restricting this to "0" is what made the first
// working build place nothing: the spawn faces a wooded corridor, so all five
// patches landed on type 1 and were correctly rejected.
terrainTypes = "0 1"

// Scan for a bearing whose ladder footprint actually lands on terrainTypes,
// rather than trusting where the player happens to be looking. Facing wins
// when it is within 5 percentage points, so the ladder stays in view when it
// can. Set to 0 to always use facing.
aimAtAcceptableGround = 1
matFile = "lcbveg.mat"

// bzfile.dll and TerrainClutter.lua both live inside the Campaign Reimagined
// mod folder, and an addon mission gets neither a mod's Lua search path nor its
// native modules -- so on a direct launch the .mat cannot be read whatever is
// installed. The mission then recovers the materials from elevation and slope,
// which is what painted them in the first place, calibrating against the map's
// own height range. These are the thresholds for that path; they do nothing
// when the .mat is readable.
calibrationSamples = 32
riverFraction = 0.12
treeFraction = 0.55
rockSlopeDegrees = 26.0
// Must match [Size] MinX/MinZ in lcbveg.trn, or every lookup is offset.
worldMinX = 0.0
worldMinZ = 0.0

// --- both -------------------------------------------------------------------
minScale = 0.80
maxScale = 1.40
slopeMax = 22.0
baseOffset = 0.02
// 0 means never distance-cull. The .trn opens visibility to 700 for this
// mission, so a stock 260 would cull the far end of the ladder and read as
// "the density fix did not work".
renderingDistance = 0.0
castShadows = 0
// Per patch, not per mission.
maxInstances = 8192
