/*****************************************************************************
  lcbench AIP matrix -- arm "allc"

  EVERY entry is a CUSTOM unit. No stock ODF name appears anywhere in this file.

  Paired with its opposite so the two files are identical in shape, scheduler
  values, account count and item counts. The ONLY difference is which unit
  family every entry names. This tests the whole FILE rather than one account:
  the earlier "custom only" arms were custom in Offense but still referenced
  stock units in Slush, Defense, FORCE_MATCHING and BUILDING_MATCHING.
 *****************************************************************************/

#include "aipdef.h"

int VERBOSE_SCHEDULER = 1;

int recompute_strategy_period = 10;

int escort_priority = 1000;
int min_escort_force = 3;
int max_escort_force = 3;
int ground_unit_threat = 50;
int threat_priority = 1000;
int distance_priority = -1;
int defend_buildings_priority = 100;
int attack_enemy_base_priority = 3000;
int persistence_priority = 400;
int exploration_priority = 100;
int scripted_priority = 0;
int single_use_group_priority = 30;
int perimeter_priority = 400;

double min_matching_force_ratio = 1.0;
double max_matching_force_ratio = 3.0;
double generic_ground_ratio = 1.0;

int min_building_defense_force = 0;
int max_building_defense_force = 2;
int min_exploration_force = 1;
int max_exploration_force = 2;
int min_perimeter_force = 1;
int max_perimeter_force = 4;
int min_attack_enemy_base_force = 5;
int max_attack_enemy_base_force = 14;

int relaxation_cycles = 0;
float relaxation_coefficient = 0.5;

#define MAX_DEFEND_BASE_GOALS 0
#define MAX_ATTACK_TROOPS_GOALS -1
#define MAX_SEIGE_GOALS 0
#define MAX_EXPLORATION_GOALS 2
#define MAX_SCRIPTED_GOALS -1
#define MAX_PERIMETER_GOALS 2

UNIT_CONSTRUCTION_PROGRAM unit_construction_program[MAX_UCP_LENGTH];

#DATA
	"Slush",	UNLIMITED,	UNLIMITED;
	"Defense",	UNLIMITED,	UNLIMITED;
	"Offense",	UNLIMITED,	UNLIMITED;
#END_DATA

ACCOUNT Slush[MAX_ACCOUNT_LENGTH];

#DATA
	21,	"mxturr",	NUMBER_TO_HAVE,		2;
#END_DATA

ACCOUNT Defense[MAX_ACCOUNT_LENGTH];

#DATA
	17,	"mxfigh",	NUMBER_TO_HAVE,		1;
#END_DATA

ACCOUNT Offense[MAX_ACCOUNT_LENGTH];

#DATA
	14,	"mxfigh",	NUMBER_TO_HAVE,		4;
#END_DATA

FORCE_MATCHING My_Matchings[MAX_FORCE_MATCHING];

#DATA
     "mxfigh",       1.0;
#END_DATA

BUILDING_MATCHING My_Building_Matchings[MAX_BUILDINGS];

#DATA
   "mxrecy",                           2.00,              CENTER_OF_BASE;
#END_DATA
