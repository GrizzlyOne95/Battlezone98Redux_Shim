	14,		"svtank",	NUMBER_TO_HAVE,		10;
	13,		"svfigh",	NUMBER_TO_HAVE,		1;
	12,		"svltnk",	NUMBER_TO_HAVE,		1;
//	10,		"svapc",	NUMBER_TO_HAVE,		2;
