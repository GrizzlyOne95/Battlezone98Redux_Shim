[ProducerBuildMenus]
; This file is optional. Without it, producer nested build menus are on, and a
; Recycler, Factory or Constructor gets them only when its own ODF names a
; [Builder] root in its [ProducerClass] section:
;
;   buildMenuRoot = b_amcmbt
;
; (buildMenu = ... also works.) Producers whose ODF has no such key keep the
; stock flat list. GOG and Steam behave the same.
;
; Copy this file to openshim_producer_build_menus.ini beside the game
; executable only to turn the feature off or to add the mappings below.

; Set Enabled=0 to turn producer nested build menus off completely.
Enabled=1

; Optional type-wide roots for producers whose ODF names none. Each value is a
; native 8-character [Builder] token, not a file path. Leaving these unset
; keeps those producers stock.
; Recycler=b_amcmbt
; Factory=b_amcmbt
; ConstructionRig=b_ambldg

; Optional per-ODF overrides: <producer odf>=<builder root>. An ODF's own
; buildMenuRoot still wins over these.
; avfact=b_amcmbt

; See Docs/producer-build-menu-test.md for the live test and log lines.
