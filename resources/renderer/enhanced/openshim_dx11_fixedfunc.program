// OpenShim DX11 fixed-function compatibility programs (SM4-only).
// Ships for Docs/DX11_LEGACY_MATERIAL_COMPATIBILITY.md Levels 1-2.
//
// OSE_FixedFunc_* emulate the bounded fixed-function support set (0 units;
// 1 unit with modulate/replace/add/alpha_blend, texture matrix, fog, alpha).
// OSE_Compat_* are the known legacy BZR/SM2/3 family adapters (Effect,
// Textured, Untextured, Sky, Base, SimpleOneTex, Ui, Terrain). They share the
// fixed-function SM4 implementation with a COMPAT_FAMILY define recording
// which legacy family selected them, so per-family tuning lands here without
// touching the resolver or rewriting mod files on disk.
//
// DX9 never loads this file: the runtime probe is DX11-gated and stock DX9
// keeps its fixed pipeline. Uniform names must match
// openshim_dx11_fixedfunc-sm4.hlsl exactly; Ogre binds them through the
// default_params auto constants below.

// ---------------------------------------------------------------------------
// Core fixed-function SM4 programs
// ---------------------------------------------------------------------------

vertex_program OSE_FixedFunc_Textured_vertex hlsl
{
    source openshim_dx11_fixedfunc-sm4.hlsl
    target vs_4_0
    entry_point fixedfunc_vertex
    default_params
    {
        param_named_auto wvpMat worldviewproj_matrix
        param_named_auto texMatrix texture_matrix 0
        param_named_auto diffuseColor surface_diffuse_colour
    }
}

fragment_program OSE_FixedFunc_Textured_fragment hlsl
{
    source openshim_dx11_fixedfunc-sm4.hlsl
    target ps_4_0
    entry_point fixedfunc_fragment
    default_params
    {
        param_named_auto sceneAmbient derived_ambient_light_colour
        param_named_auto fogColour fog_colour
        param_named_auto fogParams fog_params
    }
}

fragment_program OSE_FixedFunc_Textured_fragment_replace hlsl
{
    source openshim_dx11_fixedfunc-sm4.hlsl
    target ps_4_0
    entry_point fixedfunc_fragment

    preprocessor_defines COMPAT_OP_REPLACE
    default_params
    {
        param_named_auto sceneAmbient derived_ambient_light_colour
        param_named_auto fogColour fog_colour
        param_named_auto fogParams fog_params
    }
}

fragment_program OSE_FixedFunc_Textured_fragment_add hlsl
{
    source openshim_dx11_fixedfunc-sm4.hlsl
    target ps_4_0
