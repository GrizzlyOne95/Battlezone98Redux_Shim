// ---------------------------------------------------------------------------
// Two-stage fixed function (2 texture units on UV set 0).
// Stage 0 modulate; the fragment variant carries the stage 1 combine.
// ---------------------------------------------------------------------------

vertex_program OSE_FixedFunc_Textured2_vertex hlsl
{
    source openshim_dx11_fixedfunc-sm4.hlsl
    target vs_4_0
    entry_point fixedfunc2_vertex
    default_params
    {
        param_named_auto wvpMat worldviewproj_matrix
        param_named_auto texMatrix texture_matrix 0
        param_named_auto texMatrix1 texture_matrix 1
        param_named_auto diffuseColor surface_diffuse_colour
    }
}

vertex_program OSE_FixedFunc_Textured2_vertex_novc hlsl
{
    source openshim_dx11_fixedfunc-sm4.hlsl
    target vs_4_0
    entry_point fixedfunc2_vertex

    preprocessor_defines COMPAT_NO_VERTEX_COLOUR
    default_params
    {
        param_named_auto wvpMat worldviewproj_matrix
        param_named_auto texMatrix texture_matrix 0
        param_named_auto texMatrix1 texture_matrix 1
        param_named_auto diffuseColor surface_diffuse_colour
    }
}

