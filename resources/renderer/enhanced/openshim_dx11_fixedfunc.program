// ---------------------------------------------------------------------------
// Suppress pair: draws nothing, binds on any vertex declaration. Bound only
// to fixed-function passes that cannot be expressed and have no programmable
// fallback, so D3D11 never sees a shaderless draw.
// ---------------------------------------------------------------------------

vertex_program OSE_FixedFunc_Suppress_vertex hlsl
{
    source openshim_dx11_fixedfunc-sm4.hlsl
    target vs_4_0
    entry_point suppress_vertex
}

fragment_program OSE_FixedFunc_Suppress_fragment hlsl
{
    source openshim_dx11_fixedfunc-sm4.hlsl
    target ps_4_0
    entry_point suppress_fragment
}
