material BZTerrainBase
{
	set $shininess "32"
    set $ambient "1 1 1"
    set $diffuse "1 1 1"
	set $specular "1 1 1"
	set $bias "0"
	set $glow "1 1 1"
	
	
	lod_values 256 512
	lod_strategy Distance	
	
    technique
    {
        scheme high-pssm
        lod_index 0
		
		pass : BZTerrainPassSchemeHighPSSM
 		{
		}
    }
	
    technique
    {
        scheme high-pssm
        lod_index 1
		
		pass : BZTerrainPassSchemeHighNoShadow
 		{
		}
    }

	technique
    {
        scheme high-pssm
        lod_index 2
		
		pass : BZTerrainPassSchemeMediumNoShadow
 		{
		}
    }

    technique
    {
        scheme high	 	
        lod_index 0
		
		pass : BZTerrainPassSchemeHigh
 		{
		}
    }
	
    technique
    {
        scheme high	 	
        lod_index 1
		
		pass : BZTerrainPassSchemeHighNoShadow
 		{
		}
    }

	technique
    {
        scheme high
        lod_index 2
		
		pass : BZTerrainPassSchemeMediumNoShadow
 		{
		}
    }

    technique
    {
        scheme high-noshadow	
        lod_index 0
		
		pass : BZTerrainPassSchemeHighNoShadow
 		{
		}
    }
	
    technique
