        lod_index 2
		  
		pass : BZTerrainPassSchemeLowNoShadow
 		{
		}
    }

    technique
    {
        scheme low-pssm
        lod_index 0
		  
		pass : BZTerrainPassSchemeLowPSSM
 		{
		}
    }

    technique
    {
