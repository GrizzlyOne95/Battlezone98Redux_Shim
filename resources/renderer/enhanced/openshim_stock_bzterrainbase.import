material BZTerrainBaseDebug
{
	lod_values 2560
	lod_strategy Distance

    technique
    {
        scheme high		
        lod_index 0
		
		pass 
 		{
			diffuse 1 0 0 1
		}
    }
	
	technique
    {
        scheme high		
        lod_index 1
		
		pass 
 		{
		
			diffuse 0 0 1 0
		}
    }

	technique
    {
        scheme high		
        lod_index 2
		
		pass 
 		{
		
			diffuse 0 1 0 0
		}
    }	
}
