//FRAGMENT PROGRAMS


//GLSLES VERSIONS

//LOWEST

fragment_program OSE_TerrainLowestNoShadow_fragmentGLSLES glsles
{
	source openshim_enhanced_terrain-fragment.glsles
	syntax glsles
	entry_point main
	preprocessor_defines VERTEX_LIGHTING=1,MAX_LIGHTS=1,EMISSIVEMAP_ENABLED=1,DETAILMAP_ENABLED=1
	default_params
	{
		param_named diffuseMap int 0
		param_named detailMap  int 1
		param_named emissiveMap int 4
	}
}

fragment_program OSE_TerrainLowestShadow_fragmentGLSLES glsles
{
	source openshim_enhanced_terrain-fragment.glsles
	syntax glsles
	entry_point main
	preprocessor_defines VERTEX_LIGHTING=1,MAX_LIGHTS=1,SHADOWRECEIVER=1,PCF_SIZE=2,EMISSIVEMAP_ENABLED=1,DETAILMAP_ENABLED=1
	default_params
	{
		param_named diffuseMap int 0
		param_named detailMap  int 1
		param_named emissiveMap int 4
		param_named shadowMap1 int 5
	}
}

fragment_program OSE_TerrainLowestPSSM_fragmentGLSLES glsles
{
	source openshim_enhanced_terrain-fragment.glsles
	syntax glsles
