		param_named_auto invShadowMapSize1 inverse_texture_size 5
		param_named_auto invShadowMapSize2 inverse_texture_size 6
		param_named_auto invShadowMapSize3 inverse_texture_size 7
		param_named pssmSplitPoints float4 0.1 16.0 64.0 256.0
	}
}





