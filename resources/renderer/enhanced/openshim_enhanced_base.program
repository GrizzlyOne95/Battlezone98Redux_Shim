//LOWEST

vertex_program OSE_BaseLowestNoShadow_vertexGLSLES glsles
{
	source openshim_enhanced_base-vertex.glsles
	syntax glsles
	entry_point main

	preprocessor_defines VERTEX_LIGHTING=1,MAX_LIGHTS=1
}

