//ENHANCED
// Keep distinct en-* program names for bundled materials while sharing the
// modern low/medium delegates and using ENHANCED_MODE for the high tier.

fragment_program OSE_BaseENHighNoShadow_fragmentGLSLES glsles
{
	source openshim_enhanced_base-fragment.glsles
	syntax glsles
	entry_point main

	preprocessor_defines MAX_LIGHTS=24,NORMALMAP_ENABLED=1,SPECULARMAP_ENABLED=1,EMISSIVEMAP_ENABLED=1,ENHANCED_MODE=1
	default_params
	{
		param_named diffuseMap int 0
		param_named normalMap int 1
		param_named specularMap int 2
		param_named emissiveMap int 3
	}
}

