; ============================================================================
; openshim.ini  -  global user/developer configuration for BZR-OpenShim
; ============================================================================
; Copy this file to "openshim.ini" beside battlezone98redux.exe / winmm.dll.
;
; openshim.ini is the normal control surface for runtime features and testing.
; Process environment variables are no longer required for the settings mapped
; below. Existing OPENSHIM_* / BZR_* environment variables remain accepted as
; compatibility fallbacks when no corresponding INI value is present.
;
; [Environment] at the end of this file is a universal compatibility escape
; hatch: any legacy or newly-added OPENSHIM_* / BZR_* variable can be placed
; there verbatim and OpenShim will see it as though it were a process variable.
; This makes one-off diagnostics testable without changing Windows launch state.
;
; BOOLEAN VALUES are case-insensitive:
;   Enabled:  1, true, on, yes, enabled
;   Disabled: 0, false, off, no, disabled
; The example uses 1 and 0 for brevity.
;
; A missing/blank/invalid key uses that setting's built-in default unless the
; comment says otherwise. Mission-script/EXU overrides remain authoritative for
; the lifetime of that mission where supported.
; ----------------------------------------------------------------------------

[General]
; Maximum simultaneous GAS sound objects.
; 0 keeps the stock engine limit. 1..256 requests that many channels; larger
; values are clamped to 256. Default: 256.
SoundChannels = 256

; Full native input.map + gamekey.map binding screen. Default: enabled.
; Backwards-compatible key alias: CustomBindingUi.
CustomBindsUi = 1

; Adds the native OpenShim settings page to Redux Options. Default: enabled.
; Writes edits back to this file losslessly and keeps a .openshim.bak backup.
SettingsUi = 1

; Restored legacy death-chunk rendering / chunkMeshes support. Default: enabled.
; Set to 0 as an emergency compatibility opt-out.
ChunkMeshes = 1

; Redux multiplayer map-list/map-refresh fixes. Default: enabled.
MapRefreshFixes = 1

; Prevent duplicate Ogre material declarations from terminating the game.
; Default: enabled. Keep this on unless isolating an Ogre compatibility issue.
OgreMaterialCollisionGuard = 1

[Startup]
; Early D3D startup hook probe. Development/diagnostic path; default: disabled.
D3DStartupHooks = 0

; Allow Redux's stock startup shell/autoload behavior. Default: disabled because
; OpenShim normally suppresses the problematic startup autoload path.
; 0 = suppress stock startup autoload, 1 = allow it.
AllowStartupAutoLoad = 0

[Terrain]
; Phase 2 one-cluster terrain proxy proof. Disabled by default and exact-build
; gated. The stock cluster remains visible.
TerrainProxyEnabled = 0
TerrainProxyZone = -1
TerrainProxyCluster = -1
; TerrainProxyZoneX = 0
; TerrainProxyZoneZ = 0
; TerrainProxyClusterX = 0
; TerrainProxyClusterZ = 0
TerrainProxyOffsetX = 0.0
TerrainProxyOffsetY = 0.0
TerrainProxyOffsetZ = 0.0
TerrainProxyVisible = 1
TerrainSemanticCapture = 0
TerrainSemanticDumpJson = 1

; Phase 3A semantic terrain renderer/validator. Stock terrain remains visible.
TerrainSemanticRenderer = 0
TerrainSemanticValidateUV = 0
TerrainSemanticLegacyUVQuantization = 1
TerrainSemanticDumpMismatches = 0

; One-shot/state-change semantic resource lifecycle records. Default: disabled.
TerrainSemanticLifecycleLog = 0

; Semantic debug visualization. Requires TerrainSemanticRenderer=1.
; 0 normal, 1 tileIndex, 2 orientation, 3 typeA, 4 typeB, 5 localUV,
; 6 atlasRect, 7 amplified semantic-vs-stock UV delta.
TerrainSemanticDebug = 0

; Deterministic framebuffer parity capture count, clamped to 0..64. 0 disables.
TerrainSemanticFrameCapture = 0
; Rendered world frames between parity captures. Minimum 1. Default: 300.
TerrainSemanticFrameCaptureStride = 300

; Phase 3B HD diffuse tile-array smoke path. DX11 only. Enabling this also
; enables the one-cluster proxy and semantic renderer. Missing/invalid resources
; fail soft to the stock atlas.
TerrainHdEnabled = 0
TerrainHdManifest = terrain_hd_tiles.json

[Display]
; Under-attack audio alert frequency: None, Minimal, or Normal. Default: Normal.
UnderAttackAlert = Normal

; Target reticle pop-up policy: Default, NeutralOnly, ExplicitOnly.
; Backwards-compatible key alias: TargetReticle.
TargetPolicy = Default

; Draw your own multiplayer vehicle flag as well as other players' flags.
; Useful for solo flag validation. Default: disabled.
MultiplayerFlagShowOwnCraft = 0

; Scrap/pilot readout layout: Legacy or Stock. Default: Legacy.
ScrapPilotHud = Legacy

; Tint engine flames by faction when EXU has not supplied a mission override.
; Default: disabled. NSDF blue, CCA red, CRA green, Black Dog purple when the
; optional purple flame texture is available.
JetFlames = 0

; Unit command/selection voice feedback. Default: enabled.
UnitVoFeedback = 1

[AutoSave]
; Rolling single-player recovery save. Default: enabled.
Enabled = 1
; Seconds between rolling AutoSave writes.
IntervalSeconds = 120
; Advanced safety/compatibility controls.
InitialDelaySeconds = 10
RetrySeconds = 15
BackupExisting = 1
RespectExternalAutoSave = 1

[Diagnostics]
; Log a limited sample of native hook hits. Noisy; default: disabled.
TraceHookHits = 0

; Enable the artillery/weapon-mask trace patch used for mask RE/validation.
; Development-only; default: disabled.
TraceArtilleryMask = 0

; Read-only Ogre animation/render overhead profiler. Default: disabled.
ProfileOgreAnimation = 0

; Read-only DX11 terrain construction capture. Default: disabled.
TerrainRenderProbe = 0
; Capture the first N distinct terrain clusters. Clamped to 1..16.
TerrainRenderProbeMaxClusters = 1
; -1 captures the first cluster(s); otherwise use a zero-based observed ordinal.
TerrainRenderProbeCluster = -1
; Write terrain_probe.json / terrain_probe_NNN.json. Default: enabled when probe
; itself is enabled.
TerrainRenderProbeDumpJson = 1

[Network]
; Multiplayer transport preference. This changes peer path preference only; it
; does not create a LAN browser/direct-IP matchmaking mode.
; Stock = engine choice, Direct = LAN/WAN direct then relay, Relay = relay only.
RoutePreference = Stock

; Fixed local UDP peer port. 0 lets Winsock choose an ephemeral port.
UdpPort = 0

; Multiplayer nickname override. Blank/absent uses the account name.
; Nickname =

; Publish nickname changes through BZRNet SetPlayerData on the live connection.
LiveNicknameKeys = 1

; Re-authorise BZRNet after nickname changes. Experimental; default: disabled.
ReauthOnNicknameChange = 0

; Inject native nickname/network-route readouts into the multiplayer lobby.
LobbyReadouts = 1

; Native BZRNet lobby integration hook.
;   Auto = preserve the existing build-specific default (GOG on, Steam off)
;   1    = explicitly enable for testing
;   0    = explicitly disable
; Auto is recommended until the Steam path is fully revalidated.
LobbyBzrnetIntegration = Auto

[SinglePlayer]
; Gameplay-affecting settings in this section are hard-disabled in network games.

; Make hovercraft-derived AI craft converge weapon aim. Default: enabled.
WeaponConvergence = 1

; Converge local-player weapon hardpoints on the smart-reticle point.
; Backwards-compatible key alias: SmartReticleConvergence.
PlayerReticleConvergence = 1

; Smart-reticle targeting distance, clamped to 1..10000. Redux stock is 200.
SmartReticleRange = 500

; Path-aware scavenger scrap scoring/reconsideration. Default: enabled.
SmartScavengerPathing = 1

; Increased turret pitch authority for airborne targets. Default: enabled.
TurretAimPitch = 1
; Multiplier clamped to 0..1.25. Stock is 0.5; default enhanced value is 0.95.
TurretAimPitchMultiplier = 0.95

; Restore legacy crouch-on-landing while jump-sniping. Default: enabled.
JumpSnipeCrouch = 1

; Force near-full-throttle turbo behavior in single-player. Default: disabled.
Turbo = 0
; Throttle threshold used by the global turbo path. Default: 0.9.
TurboTolerance = 0.9

; Native stock headlights. These stand down in multiplayer and when EXU owns
; scripted lighting for the mission.
Headlights = 1
OtherHeadlights = 0
; Stock, White, Red, Green, Blue, Yellow, Cyan, Magenta, Orange, Purple, Teal,
; Rainbow, or a finite custom r,g,b triple with components in 0..20.
HeadlightColor = White
; Stock, Focused, or Wide.
HeadlightBeam = Wide

[Environment]
; ---------------------------------------------------------------------------
; Legacy/raw environment compatibility
; ---------------------------------------------------------------------------
; Any OPENSHIM_* or BZR_* variable that is not yet represented by a friendly
; key above can be placed here verbatim. OpenShim checks this section before the
; real process environment. This is primarily for developer diagnostics and
; temporary RE probes; prefer the friendly keys above for normal configuration.
;
; Examples (uncomment only when needed):
; OPENSHIM_FORCE_PUBLIC_ROUTE = 1
; OPENSHIM_FORCE_RELAY_ROUTE = 1
; OPENSHIM_FORCE_P2P_ROUTE = 1
; OPENSHIM_FORCE_NET_INTERFACE = 192.168.1.10
; OPENSHIM_MIGRATE_NETWORK_INI = 1
;
; Existing process environment variables remain accepted as a final backward-
; compatibility fallback, so old launch scripts continue to work.
