; ============================================================================
; openshim.ini  -  authoritative global user/developer configuration reference
; ============================================================================
; Copy this file to "openshim.ini" beside battlezone98redux.exe / winmm.dll.
;
; This file documents every first-class openshim.ini key supported by the
; current OpenShim runtime, including accepted values, aliases, ranges, defaults,
; scope, and restart/live-apply behavior where known.
;
; Separate configuration files are intentionally not duplicated here:
;   openshim_producer_build_menus.ini  = producer/nested build-menu experiment
;   net.ini                            = low-level socket optimizer/reorder lab,
;                                        netcode tuning ([OpenShimSocket] Net*,
;                                        AutoKick*, GovernorStart) and the raw
;                                        capture switches. Every key there is
;                                        documented in that file. The one
;                                        crossover is [Diagnostics] RelayLogging
;                                        below, which drives the relay capture
;                                        from here so testers have a single
;                                        switch to set.
;
; Environment compatibility:
;   Friendly INI keys below are the normal control surface. Historical
;   OPENSHIM_* / BZR_* process variables remain backward-compatible fallbacks.
;   [Environment] at the end of this file can also supply raw legacy/probe
;   variables without changing the Windows process environment.
;
; BOOLEAN PARSING
;   Most first-class boolean settings use the friendly parser:
;     ON:  1, true, on, yes, enabled
;     OFF: 0, false, off, no, disabled
;   Matching is case-insensitive.
;
;   IMPORTANT: settings explicitly marked "integer flag" are read by Win32
;   integer APIs. For those, use 0 for OFF and 1 for ON. Any non-zero integer is
;   treated as ON, but 0/1 is the supported/documented form.
;
; ENUM PARSING
;   Text enums are case-insensitive. Where noted, spaces, underscores, and
;   hyphens are ignored. Prefer the canonical values shown first.
;
; A missing, blank, or invalid value falls back to the documented default unless
; a setting says otherwise. Mission/EXU overrides remain authoritative for the
; lifetime of that mission where supported.
;
; Section scope:
;   [General]      engine/UI behavior
;   [Startup]      startup-only hooks/behavior
;   [Terrain]      terrain replacement/proxy development controls
;   [Display]      local/cosmetic behavior
;   [AutoSave]     rolling single-player recovery save
;   [Diagnostics]  read-only traces/probes unless explicitly noted
;   [Network]      BZRNet/user-facing multiplayer preferences
;   [SinglePlayer] simulation-affecting improvements; forced off in MP
; ----------------------------------------------------------------------------

[General]

; Maximum simultaneous GAS sound objects.
; Accepted:
;   0       = disable OpenShim's override; retain the stock engine limit
;   1..256  = requested channel count
;   >256    = accepted but clamped to 256
; Use a non-negative whole decimal number. Default: 256.
; Legacy env aliases: OPENSHIM_MAX_SOUND_CHANNELS, BZR_MAX_SOUND_CHANNELS
SoundChannels = 256

; Full native input.map + gamekey.map binding screen.
; Accepted: boolean. Default: ON. Restart required after changing.
; Legacy INI alias: CustomBindingUi
; Legacy env aliases:
;   enable  OPENSHIM_ENABLE_INPUT_BINDING_UI
;           OPENSHIM_ENABLE_INPUT_BINDING_UI_REPLACEMENT
;           BZR_ENABLE_INPUT_BINDING_UI
;   disable OPENSHIM_DISABLE_INPUT_BINDING_UI
;           OPENSHIM_DISABLE_INPUT_BINDING_UI_REPLACEMENT
;           BZR_DISABLE_INPUT_BINDING_UI
CustomBindsUi = 1

; Adds the native OpenShim Settings page to Redux Options.
; Accepted: boolean. Default: ON.
; The page edits this file losslessly and keeps a .openshim.bak backup.
; Legacy env aliases: OPENSHIM_DISABLE_SETTINGS_UI, BZR_DISABLE_SETTINGS_UI
SettingsUi = 1

; Restored legacy death-chunk rendering / chunkMeshes support.
; Accepted: boolean. Default: ON.
; Set OFF only as a compatibility/emergency opt-out.
; Legacy env aliases: OPENSHIM_DISABLE_CHUNK_EXPERIMENTS,
;                     BZR_DISABLE_CHUNK_EXPERIMENTS
ChunkMeshes = 1

; Redux multiplayer map-list refresh/selection preservation fixes.
; Accepted: boolean. Default: ON.
; Legacy env aliases: OPENSHIM_DISABLE_MAP_REFRESH_FIXES,
;                     BZR_DISABLE_MAP_REFRESH_FIXES
MapRefreshFixes = 1

; Keep the soundtrack playing when the game is not the foreground window.
; Accepted: boolean. Default: ON. Restart required.
; Redux creates its streaming music buffer without DirectSound's GLOBALFOCUS
; flag, so Windows stops that buffer on every focus change. Because the decoder
; is woken by play-position notifications, a stopped buffer also stops being
; refilled -- so on returning to the game the music audibly skips while the
; streaming thread catches up. Alt-tab is the obvious trigger; overlays and
; notification popups do the same thing more briefly.
; Set OFF to restore stock behavior (music mutes while alt-tabbed).
; Legacy env alias: OPENSHIM_DISABLE_MUSIC_GLOBAL_FOCUS
MusicGlobalFocus = 1

; Win32 raw mouse input for camera look.
; Accepted: boolean. Default: ON. Restart required.
; Redux already implements a complete raw-input path -- it registers the mouse
; with RegisterRawInputDevices, handles WM_INPUT, and feeds the relative deltas
; into the same look accumulator and the same sensitivity setting the ordinary
; mouse path uses -- but the enable flag it keys off is zero-initialised, so
; nothing turns it on unless you pass the stock `rawinput` command-line token.
; This setting turns it on by default.
; With it ON the engine reads mouse movement straight from the device, so look
; is unaffected by pointer acceleration, by the desktop pointer-speed slider,
; and by the screen edge. The stock code already skips its legacy
; WM_MOUSEMOVE look path whenever raw input is active, so the two never
; contribute at once. Controller and keyboard input are untouched.
; Set OFF to restore the stock behavior (legacy mouse-message path).
; Sensitivity is unchanged: both paths share the in-game sensitivity setting.
; Precedence: `rawinput` / `norawinput` on the command line beat the env
; overrides, which beat this file.
; Legacy env aliases: OPENSHIM_DISABLE_RAW_MOUSE_INPUT,
;                     BZR_DISABLE_RAW_MOUSE_INPUT
; Diagnostics: set OPENSHIM_TRACE_RAW_INPUT=1 to log raw packet flags and
; deltas to logs\; the [RAWINPUT] startup lines report whether the path
; verified and engaged.
RawMouseInput = 1

; Prevent duplicate Ogre material declarations from escaping script parsing as
; ERR_DUPLICATE_ITEM and terminating the game.
; Accepted: boolean. Default: ON.
; Legacy env aliases:
;   enable  OPENSHIM_ENABLE_OGRE_MATERIAL_COLLISION_GUARD
;           BZR_ENABLE_OGRE_MATERIAL_COLLISION_GUARD
;   disable OPENSHIM_DISABLE_OGRE_MATERIAL_COLLISION_GUARD
;           BZR_DISABLE_OGRE_MATERIAL_COLLISION_GUARD
OgreMaterialCollisionGuard = 1


; Restore the BZ 1.5 display order of the overhead view and the control panel,
; which is what makes editor object placement work in the Shift+F10 overhead
; view while the simulation is running.
;
; Redux transposed two DisplayInterface::AddView priority constants, so the
; control panel renders before the overhead view instead of after it. The
; control panel is what turns a build-menu keypress into an object, and it
; needs the ground position that the overhead view publishes earlier in the
; same frame. With the order reversed it reads the stale null that
; Reticle::Simulate writes each simulated frame: the keypress plays its click
; sound and nothing is placed. Pausing works around it only because the
; simulation stops nulling the pointer, which is also why the cursor freezes.
;
; Only affects sessions that reach the overhead view with editor/arcade mode
; on, which requires the game to have been launched with /edit.
;
; NOTE: unlike the [SinglePlayer] section, this one cannot be hard-disabled in
; network games. It is applied from DllMain, before the executable's entry
; point, because both patch sites are global constructors that have already run
; by the time the normal patch thread starts -- and no network state exists that
; early. The change restores stock 1.5 ordering rather than inventing new
; behavior, but it does move where the control panel emits its commands within
; the frame, so leave it off unless you are using the editor.
;
; Accepted: boolean. Default: OFF. Restart required after changing.
EditorOverheadPlacementOrder = 0

; Suppress the stale "under attack" growl that fires the instant you hop out.
;
; The cockpit radar warns about any friendly whose enemyShot timestamp is
; newer than the alert cooldown, and it excludes exactly one object: the one
; you currently are. Hopping out moves that to the pilot, so the craft you
; just left stops being excluded, and if an enemy shot it at any point since
; the last warning its old timestamp is replayed as a fresh alert -- once.
;
; With this on, the alert cooldown is raised to exactly that one stale
; timestamp at the moment the player object changes. Nothing else moves: any
; genuinely newer hit still carries a later timestamp and still warns you,
; including further fire on the craft you just abandoned.
;
; NOTE: this is a deliberate deviation from stock. Battlezone 1.5's
; CockpitRadar::Render has the same three conditions, so the beep is original
; behaviour, not a Redux regression. Audio only -- no simulation effect.
;
; Accepted: boolean. Default: ON.
; Legacy env alias to force it off: OPENSHIM_DISABLE_HOP_OUT_ATTACK_ALERT_FIX
SuppressHopOutAttackAlert = 1
[Startup]

; Early D3D startup-hook path used for renderer/startup development.
; Accepted: boolean. Default: OFF. Restart required.
; Legacy env alias: OPENSHIM_ENABLE_D3D_STARTUP_HOOKS
D3DStartupHooks = 0

; Whether to allow Redux's stock startup shell/autoload behavior.
; Accepted: boolean. Default: OFF.
;   OFF = OpenShim suppresses the stock startup autoload path
;   ON  = allow the stock path
; Legacy env alias: OPENSHIM_ALLOW_STARTUP_AUTOLOAD
AllowStartupAutoLoad = 0


[Terrain]

; NOTE: terrain booleans below are integer flags; use 0/1.

; Master one-cluster terrain proxy proof path.
; Accepted: 0/1. Default: 0.
; The proxy clones one stock 16x16-cell cluster and leaves stock terrain visible.
TerrainProxyEnabled = 0

; Optional construction-ordinal selectors.
; Accepted: integer.
;   -1 = no ordinal filter; first cluster matching the remaining selectors wins
;   0+ = select that observed construction ordinal
TerrainProxyZone = -1
; Cluster ordinal is clusterX*4 + clusterZ, so native clusters are normally 0..15.
TerrainProxyCluster = -1

; Optional native coordinate selectors. Commented/absent = no coordinate filter.
; Native cluster X/Z are 0..3. Zone X/Z are the native identifiers embedded in
; RenderableTileCluster_<zoneX>x<zoneZ>_<clusterX>x<clusterZ>.
; TerrainProxyZoneX = 0
; TerrainProxyZoneZ = 0
; TerrainProxyClusterX = 0
; TerrainProxyClusterZ = 0

; Pick the cluster the active camera can actually see, instead of the implicit
; "first constructed cluster" default. Accepted: integer flag 0/1. Default: 0.
; Without this, selection settles on cluster ordinal 0, which the mission-start
; camera does not look at -- captures then contain only static UI. Selection is
; deferred until the player object and a camera exist and some cluster of the
; dispatched zone contains the aim point, so it normally lands a few dispatches
; into gameplay rather than at zone construction. Explicit ordinal/coordinate
; selectors above still constrain the candidates. Falls back to ordinal
; selection if the OGRE camera exports do not resolve.
TerrainProxyFollowCamera = 0

; How far ahead of the player the aim point is pushed, in world units.
; Accepted: finite decimal >= 0. Default: 35.0.
; The aim point is the player's own simulation position projected along the
; camera's view direction; the cluster whose world bounds contain it is the one
; selected. The player is used rather than the eye because the render camera can
; be a chase or satellite view far from them, and because the player is always
; standing on terrain, which makes containment resolve.
TerrainProxyFollowCameraAimDistance = 35.0

; Re-choose the cluster after this many rendered frames with the proxy unframed.
; Accepted: integer >= 0; 0 disables re-selection. Default: 300.
; Selection runs once against whatever camera exists at the time, and a player
; moves, so without this the proxy can sit behind the camera for the rest of the
; mission. Each re-selection rebuilds a material and its programs, so the count
; is capped at 16 per mission.
TerrainProxyFollowCameraReselectFrames = 300

; Proxy translation in world units. Accepted: finite decimal; default 0.0.
; NOTE: with TerrainProxyFollowCamera=1 a large offset moves the proxy away
; from the visible stock cluster that was selected, so the proxy itself may be
; off screen. The capture framing check below tests the proxy, not the source.
TerrainProxyOffsetX = 0.0
TerrainProxyOffsetY = 0.0
TerrainProxyOffsetZ = 0.0

; Show the proxy mesh. Accepted: integer flag 0/1. Default: 1.
TerrainProxyVisible = 1

; Capture logical terrain semantics for the selected proxy.
; Accepted: integer flag 0/1. Default: 0.
TerrainSemanticCapture = 0

; Write semantic capture JSON when capture is enabled.
; Accepted: integer flag 0/1. Default: 1.
TerrainSemanticDumpJson = 1

; Phase 3A semantic renderer. Stock terrain remains authoritative/visible.
; Accepted: integer flag 0/1. Default: 0.
TerrainSemanticRenderer = 0

; Compare semantic UV reconstruction against stock packed UVs.
; Accepted: integer flag 0/1. Default: 0.
TerrainSemanticValidateUV = 0

; Preserve stock legacy UV quantization in semantic rendering.
; Accepted: integer flag 0/1. Default: 1.
TerrainSemanticLegacyUVQuantization = 1

; Dump individual semantic UV mismatches.
; Accepted: integer flag 0/1. Default: 0.
TerrainSemanticDumpMismatches = 0

; Log semantic vertex-buffer/material/program create/bind/retain/destroy state.
; Accepted: integer flag 0/1. Default: 0.
TerrainSemanticLifecycleLog = 0

; Semantic debug visualization. Requires TerrainSemanticRenderer=1.
; Accepted integer modes:
;   0 = normal semantic shading / debug OFF
;   1 = tileIndex: deterministic color per runtime tile id
;   2 = orientation: all 16 orientation/mix values rendered distinctly
;   3 = typeA: high terrain-type nibble
;   4 = typeB: low terrain-type nibble
;   5 = localUV: post-orientation local UV as red/green gradients
;   6 = atlasRect: atlas origin (u,v) with width in blue
;   7 = uvDelta: |semantic UV - stock packed UV| amplified 640x
; Any value outside 0..7 falls back to 0. Default: 0.
TerrainSemanticDebug = 0

; Deterministic full-frame PNG captures for semantic parity testing.
; Accepted: integer 0..64; values <0 become 0, >64 become 64.
; 0 disables capture. Default: 0.
TerrainSemanticFrameCapture = 0

; Rendered world frames between deterministic captures.
; Accepted: integer >=1. Values <1 become 1. Default: 300.
; With the framing gate below this is a minimum spacing rather than an exact
; frame index: a capture slot waits past its stride boundary until the cluster
; is framed.
TerrainSemanticFrameCaptureStride = 300

; Only write a capture when the proxy cluster is actually on screen.
; Accepted: integer flag 0/1. Default: 1.
; The shim projects the proxy's world bounds through the active camera; a
; capture is written only when Ogre's frustum test passes, at least one bounds
; corner is in front of the eye plane, and the projected rect covers at least
; TerrainSemanticFrameCaptureMinCoverage of the viewport, for two consecutive
; frames. Set to 0 for the old fixed-frame-index behaviour, which will happily
; write captures containing nothing but HUD. If the camera exports cannot be
; resolved at all, the shim logs once and captures without the check rather
; than blocking.
TerrainSemanticFrameCaptureRequireOnScreen = 1

; Minimum fraction of the viewport the projected cluster must cover before a
; capture counts as framed. Accepted: decimal 0.0..1.0. Default: 0.005.
; Terrain is seen at a grazing angle, so a cluster projects to a thin band: on
; the live build none exceeded 0.0164 of a 3840x2160 viewport. A band of roughly
; 500x250 px is entirely measurable, so the bar is deliberately low.
TerrainSemanticFrameCaptureMinCoverage = 0.005

; Phase 3B HD diffuse tile-array smoke path. DX11 only.
; Accepted: integer flag 0/1. Default: 0.
; ON also enables the one-cluster proxy and semantic renderer. Missing/invalid
; resources fail soft to the stock atlas.
TerrainHdEnabled = 0

; HD tile manifest path. Accepted: non-empty path string.
; Relative paths resolve from battlezone98redux.exe; absolute paths are allowed.
; Default: terrain_hd_tiles.json
TerrainHdManifest = terrain_hd_tiles.json


[Display]

; Under-attack audio alert frequency.
; Canonical values:
;   None    = silent
;   Minimal = rare warning beeps, roughly 10-second cooldown
;   Normal  = stock/default cadence, roughly 1-second cooldown
; Accepted aliases:
;   None    : Off, numeric <=1
;   Minimal : Low, numeric 2
;   Normal  : Default, On, numeric >=3
; Text is case-insensitive and spaces are ignored. Default: Normal.
UnderAttackAlert = Normal

; Target-reticle popup policy.
; Canonical values:
;   Default      = stock behavior
;   NeutralOnly  = suppress recent-hit popups for team-0/neutral objects
;   ExplicitOnly = only show when explicitly targeted
; Accepted aliases:
;   Default      : Normal, On, numeric <=1
;   NeutralOnly  : Neutral, numeric 2
;   ExplicitOnly : Explicit, numeric >=3
; Spaces, underscores, and hyphens are ignored. Default: Default.
; Legacy INI alias: TargetReticle
TargetPolicy = Default

; Also draw your own multiplayer vehicle flag over your own craft.
; Accepted: boolean. Default: OFF.
; OFF = only other players' flags render; ON = render your own flag too.
; Legacy env aliases: OPENSHIM_MP_FLAG_SHOW_OWN, BZR_MP_FLAG_SHOW_OWN
MultiplayerFlagShowOwnCraft = 0

; Scrap/pilot readout layout.
; Canonical:
;   Legacy = compact legacy top-center layout; hide stock backing panels
;   Stock  = Redux positions/panels
; Accepted aliases:
;   Legacy : Compact, 1, On, True
;   Stock  : Default, 0, Off, False
; Default: Legacy.
ScrapPilotHud = Legacy

; Faction-colored jet/thruster flames.
; Accepted: boolean. Default: OFF.
;   a / NSDF      = stock blue
;   s / CCA       = red
;   c / CRA       = green
;   b / Black Dog = purple when the optional purple flame asset is present
; Legacy env aliases:
;   enable  OPENSHIM_FACTION_JET_FLAMES, BZR_FACTION_JET_FLAMES
;   disable OPENSHIM_DISABLE_FACTION_JET_FLAMES,
;           BZR_DISABLE_FACTION_JET_FLAMES
JetFlames = 0

; Unit command/selection voice feedback.
; Canonical values:
;   Normal  = normal stock feedback
;   Reduced = reduced chatter
;   None    = mute the unit-feedback category
; Boolean aliases are also accepted:
;   ON/true/1  -> Normal
;   OFF/false/0 -> None
; Default: Normal. Mission/EXU overrides may temporarily supersede it.
UnitVoFeedback = Normal


[AutoSave]

; NOTE: AutoSave values are read as integers. Use numeric values shown below.

; Rolling single-player recovery save.
; Accepted: 0 = OFF, non-zero = ON. Default: 1.
Enabled = 1

; Seconds between rolling AutoSave writes.
; Accepted: integer; clamped to 10..3600 seconds. Default: 120.
; In-game Settings page presets: 60, 120, 180, 300, 600.
IntervalSeconds = 120

; Delay after mission start before AutoSave may first write.
; Accepted: integer; clamped to 0..600 seconds. Default: 10.
InitialDelaySeconds = 10

; Delay before retrying after a failed/deferred AutoSave.
; Accepted: integer; clamped to 5..120 seconds. Default: 15.
RetrySeconds = 15

; Back up an existing AutoSave before replacement.
; Accepted: 0 = OFF, non-zero = ON. Default: 1.
BackupExisting = 1

; Avoid fighting another system/script that owns the AutoSave slot.
; Accepted: 0 = OFF, non-zero = ON. Default: 1.
RespectExternalAutoSave = 1


[Diagnostics]

; Log a limited sample of native patch/hook hits.
; Accepted: boolean. Default: OFF. Noisy.
; Legacy env alias: OPENSHIM_TRACE_HITS
TraceHookHits = 0

; Enable artillery/weapon-mask tracing for RE/validation.
; Accepted: boolean. Default: OFF. Development-only.
; Legacy env aliases: OPENSHIM_TRACE_ARTILLERY_MASK,
;                     OPENSHIM_TRACE_WEAPON_MASK
TraceArtilleryMask = 0

; Trace DX11 texture/SRV/backbuffer/color-space activity.
; Accepted: integer flag 0/1. Default: 0. Very noisy diagnostic.
; Legacy env alias: OPENSHIM_TRACE_DX11_COLORSPACE
TraceDX11ColorSpace = 0

; Trace the multiplayer map-list refresh, filter and scroll path.
; Accepted: boolean. Default: OFF.
; Logs [MAPTRACE] lines for list rebuilds, selection restore, and each
; filter scroll step. Use when investigating the map list or the menu hop.
; Legacy env aliases: OPENSHIM_TRACE_MAP_REFRESH,
;                     OPENSHIM_TRACE_STEAM_MAP_REFRESH
TraceMapRefresh = 0

; Trace the player Person::Simulate jump-snipe probe.
; Accepted: boolean. Default: OFF.
; Installs an observational probe on the local player's simulate path and
; logs [JUMPSNIPE] lines. Development-only; adds per-frame work.
; Legacy env aliases: OPENSHIM_TRACE_JUMP_SNIPING, OPENSHIM_TRACE_JUMPSNIPE
TraceJumpSniping = 0

; Sample per-object satellite/overview visibility state.
; Accepted: boolean. Default: ON (temporarily, see below).
; Logs [SATVIS] lines while the satellite view is open, sampling the
; GameObject fields that Battlezone 1.5 used to decide what appeared in
; satellite view: illumination, isVisible, seen, perceivedTeam, class type
; and isObjective, plus derived detected/discovered/legacyVisible columns.
; legacyVisible is `illumination > 0` -- the exact test 1.5's
; Submit_Overview_Entities applied per object -- so a capture can be scored
; directly against the legacy behaviour table.
;
; This is ON by default only while the satellite fog-of-war regression is
; being characterised (feature item 24); it will return to OFF once that is
; resolved. Read-only sampling, no gameplay effect.
;
; As of 2026-08-18 it also resolves each object to its Ogre entity via
; GameObject -> [+0xF0] -> [+0x94] (the chain ExtraUtilities uses for its
; distance culling) and records Ogre's own getVisible() alongside the legacy
; illumination gate. A line marked LEAK is an object BZ 1.5 would have kept
; out of the overview that Redux is still drawing -- that pairing is the whole
; point of the capture.
;
; It no longer returns early outside satellite view, because the question is
; how effective visibility changes as you enter and leave view 3, and that
; needs samples on both sides. Still rate-limited to one sample per second and
; still stops once the budget is spent. Set to 0 to silence it.
;
; Background and the live-test plan:
;   reverse_engineering/satellite_fow_root_cause_20260817.md
; Legacy env aliases: OPENSHIM_TRACE_SAT_VIS,
;                     OPENSHIM_TRACE_SATELLITE_VISIBILITY, BZR_TRACE_SAT_VIS
; To force it off from the environment instead: OPENSHIM_DISABLE_SAT_VIS=1
TraceSatelliteVisibility = 1

; Tuning for the sampler above. These have no dedicated INI keys yet; set the
; environment names verbatim under [Environment] at the end of this file if
; you need to change them:
;   OPENSHIM_SAT_VIS_BUDGET        total samples per session   (default 120)
;   OPENSHIM_SAT_VIS_INTERVAL_MS   minimum ms between samples  (default 1000)
;   OPENSHIM_SAT_VIS_OBJECT_LIMIT  objects inspected per sample (default 96)

; Read-only Ogre animation/render overhead profiler.
; Accepted: boolean. Default: OFF.
; Emits roughly one-second samples for animation, software vertex blending,
; render-queue work, Draw/DrawIndexed, and Present activity.
; Legacy env alias: OPENSHIM_PROFILE_OGRE_ANIMATION
ProfileOgreAnimation = 0

; Read-only DX11 terrain-construction capture.
; Accepted: boolean/integer flag; use 0/1. Default: 0.
; Legacy env alias: OPENSHIM_TERRAIN_RENDER_PROBE
TerrainRenderProbe = 0

; Number of distinct terrain clusters to capture.
; Accepted: integer; clamped to 1..16. Default: 1.
TerrainRenderProbeMaxClusters = 1

; Select one observed terrain-cluster ordinal.
; Accepted: integer >=-1.
;   -1 = capture the first clusters up to TerrainRenderProbeMaxClusters
;   0+ = only capture that zero-based observed ordinal
; Values below -1 become -1. Default: -1.
TerrainRenderProbeCluster = -1

; Write terrain_probe.json / terrain_probe_NNN.json.
; Accepted: integer flag 0/1. Default: 1.
TerrainRenderProbeDumpJson = 1

; ---------------------------------------------------------------------------
; BZRNet relay / dedicated-server control-plane logging
; ---------------------------------------------------------------------------
; PRIVACY: these captures record public endpoints, account identity, lobby
; metadata, and packet payload fragments belonging to everyone in the session,
; not just you. Keep them local, read them before sharing, and get the other
; participants' consent. All of it is OFF by default.

; Master switch for BZRNet relay and control-plane logging.
; Accepted: boolean. Default: OFF.
; Turning this on enables, together:
;   - bz_relay_control.jsonl, the WebSocket control-plane message log
;   - the structured BZRNet trace (socket lifecycle, WS frames, UDP)
;   - the raw datagram ring the two are carried on
; This is the one key to set when asked for relay logs. The individual
; net.ini [OpenShimSocket] switches remain available for finer control.
; Legacy env aliases: OPENSHIM_RELAY_CAPTURE, BZ_RELAY_CAPTURE,
;                     OPENSHIM_BZRNET_TRACE, BZ_BZRNET_TRACE
RelayLogging = 0

; Log every control-plane message instead of only the eight route-deciding
; ones (DoUpdateLAN/WAN, OnLAN/WANUpdated, DoP2PConnect,
; OnLobbyMemberP2PConnect, DoP2PRoute, OnP2PRoute).
; Accepted: boolean. Default: OFF. Implies RelayLogging.
; Turn this on to capture the whole conversation a dedicated/replacement
; matchmaking service has to reproduce: Authorization, DoEnterLounge,
; DoJoinLobby, SetPlayerData, game creation, chat, member join/leave.
; Legacy env alias: OPENSHIM_RELAY_LOG_ALL_CONTROL
RelayLogAllControl = 0

; Log every datagram on the BZRNet endpoint-probe (1338) and UDP relay (1339)
; ports, unsampled.
; Accepted: boolean. Default: OFF. Implies RelayLogging.
; Ordinary packet logging is sampled by count, which can miss a whole sparse
; relay negotiation; this is the unsampled view of it. Per-packet volume.
; Legacy env alias: OPENSHIM_RELAY_LOG_DATAGRAMS
RelayLogDatagrams = 0

; Include full payloads and unredacted identity in the structured trace.
; Accepted: boolean. Default: OFF. Forensic use only; review before sharing.
; Legacy env aliases: OPENSHIM_BZRNET_TRACE_PRIVATE, BZ_BZRNET_TRACE_PRIVATE
RelayLoggingPrivateForensic = 0

; Trace all UDP sockets, not only the BZRNet ports.
; Accepted: boolean. Default: OFF. High volume during a match.
; Legacy env aliases: OPENSHIM_BZRNET_TRACE_ALL_UDP, BZ_BZRNET_TRACE_ALL_UDP
RelayLoggingAllUdp = 0

; Depth of the trace's in-memory queue, in records.
; Accepted: integer; clamped to 256..65536. Default: 4096.
; Raise this if the log reports dropped records under load.
; Legacy env aliases: OPENSHIM_BZRNET_TRACE_QUEUE, BZ_BZRNET_TRACE_QUEUE
RelayLoggingQueueRecords = 4096



; Read-only probe: log what GameObject::SetDamageFlags actually reveals.
;
; When a captured/disguised craft lands a shot, the reveal tail sets
; perceivedTeam on the DAMAGE struct's damager field. In BZ 1.5 that field
; holds the OWNER -- Explosion::Init stores the firing craft there while
; dmg_source holds the explosion -- so 1.5 reveals the craft itself. Whether
; Redux reaches the reveal with the craft or with an owned projectile has not
; been established statically, and that distinction is the difference between
; a stolen tank being unmasked and it staying disguised while it kills your
; units (BZ98ReduxBugTracker #38).
;
; Emits [DMGREVEAL] lines carrying, for the victim, the damager and the
; damage source: pointer, RTTI class name, actual team, and perceivedTeam
; before and after the stock call. The line that changed is marked REVEALED.
; It also lists which fields of the damager point at another live GameObject,
; which locates any owner link by measurement instead of a guessed offset.
;
; Read-only: the probe records state, calls the stock function, records state
; again, and changes nothing. Budgeted (400 events) and OFF by default -- it
; logs on every damaging hit, so leave it off for normal play.
;
; Decisive test: have a sniped/captured craft land exactly one damaging shot.
; Accepted: boolean. Default: OFF.
; Legacy env aliases: OPENSHIM_TRACE_DAMAGE_REVEAL, BZR_TRACE_DAMAGE_REVEAL
TraceDamageReveal = 0

[Network]

; Netcode tuning -- the send-rate governor, bandwidth floor/ceiling, ramp rates
; and auto-kick envelope -- lives in net.ini under [OpenShimSocket], because it
; is applied by the socket layer. It is on by default and needs no
; configuration here; see net.ini for what each value does and why. Relay and
; control-plane logging is under [Diagnostics] above.

; Preferred gameplay peer route. This changes route preference only; it does
; not add LAN browsing or direct-IP matchmaking.
; Canonical:
;   Stock  = leave Redux's route choice alone
;   Direct = try LAN, then direct WAN, then relay fallback
;   Relay  = skip direct paths and use BZRNet relay
; Accepted aliases:
;   Stock  : Auto, Default
;   Direct : PreferDirect
;   Relay  : ForceRelay
; Spaces, underscores, and hyphens are ignored. Default: Stock.
RoutePreference = Stock

; Fixed local UDP port for BZRNet peer traffic.
; Accepted: integer 0..65535.
;   0 = stock behavior / Winsock chooses an ephemeral port
; Changing this requires restart because the value is consumed before bind.
; Default: 0.
UdpPort = 0

; Multiplayer nickname override.
; Accepted: text up to 127 characters.
; Blank/absent = use the Steam/GOG account name.
; Nickname =

; Publish nickname edits to the open BZRNet connection via live player-data keys.
; Accepted: boolean. Default: ON.
; Legacy env alias: OPENSHIM_DISABLE_LIVE_NICKNAME
LiveNicknameKeys = 1

; Re-authorise BZRNet after a nickname edit.
; Accepted: boolean. Default: OFF. Experimental; use only for testing.
; Legacy env alias: OPENSHIM_DISABLE_BZRNET_REAUTH
ReauthOnNicknameChange = 0

; Inject the native nickname and negotiated-route readouts into the MP lobby.
; Accepted: boolean. Default: ON.
; Legacy env alias: OPENSHIM_DISABLE_LOBBY_READOUTS
LobbyReadouts = 1

; Native BZRNet lobby-integration patch gate.
; Canonical:
;   Auto = preserve current platform default (GOG ON, Steam OFF)
; Boolean values are also accepted:
;   ON/true/1  = explicitly enable
;   OFF/false/0 = explicitly disable
; Default: Auto. Auto is recommended until the Steam hook path is revalidated.
LobbyBzrnetIntegration = Auto


[SinglePlayer]

; All simulation-affecting settings in this section are hard-disabled in
; network games regardless of their configured values.

; Make hovercraft-derived AI craft converge fixed-weapon fire on the aim point.
; Accepted: boolean. Default: ON.
WeaponConvergence = 1

; Converge the local player's weapon hardpoints on the smart-reticle position.
; Accepted: boolean. Default: ON.
; Legacy INI alias: SmartReticleConvergence
PlayerReticleConvergence = 1

; Smart-reticle targeting distance.
; Accepted: finite decimal; clamped to 1..10000.
; Default: 500. Redux stock value: 200.
; Legacy INI alias: ReticleRange
SmartReticleRange = 500

; Score scrap by viable path length and reconsider temporarily unreachable scrap.
; Accepted: boolean. Default: ON.
; Legacy INI alias: ScavengerPathing
SmartScavengerPathing = 1

; Give defensive turrets increased pitch authority against airborne targets.
; Accepted: boolean. Default: ON.
TurretAimPitch = 1

; Enhanced turret pitch multiplier.
; Accepted: finite decimal; clamped:
;   <0.0       -> 0.0
;   0.0..1.25  -> used as written
;   >1.25      -> 1.25
; Default: 0.95. Redux stock multiplier: 0.5.
; Legacy env aliases: OPENSHIM_TURRET_AIM_PITCH_MULTIPLIER,
;                     OPENSHIM_TURRET_PITCH_MULTIPLIER
TurretAimPitchMultiplier = 0.95

; Restore legacy crouch-on-landing while jump-sniping.
; Accepted: boolean. Default: ON.
JumpSnipeCrouch = 1

; Make artillery and lay-mines AI honour the unit's weaponMask when choosing a
; hardpoint.
;
; This is NOT a bug fix. Battlezone 1.5 behaves exactly as stock Redux does:
; artillery AI takes the first fitted weapon in hardpoint order and the lay-mines
; task hard-codes hardpoint 0, and neither one reads weaponMask in either build.
; Turning this on is a deliberate departure from original Battlezone behaviour,
; which is why it defaults OFF.
;
; The rule is "lowest set bit of (weaponMask AND fitted hardpoints)", falling
; back to stock whenever the mask selects nothing that is actually fitted. With
; the default ODF mask 11111 that resolves to the first fitted hardpoint -- the
; same weapon stock would have picked -- so units without an explicit,
; non-default mask are completely unaffected.
;
; ODF masks are read as decimal digits with the rightmost digit as hardpoint 0:
;   00001 -> hardpoint 0    00010 -> hardpoint 1    00100 -> hardpoint 2
;
; Simulation-affecting, so like everything in this section it is hard-disabled in
; network games regardless of the value set here.
;
; Accepted: boolean. Default: OFF.
AiWeaponMaskSelection = 0

; Make turbo available globally on drivable units.
; Accepted: boolean. Default: OFF.
Turbo = 0

; Throttle threshold used by the global turbo path.
; Accepted: finite decimal. Default: 0.9.
; Legacy env alias: OPENSHIM_GLOBAL_TURBO_TOLERANCE
TurboTolerance = 0.9

; Native stock headlight control. These stand down in multiplayer and when EXU
; owns scripted mission lighting.
; Accepted: boolean. Default: Player ON, AI OFF.
Headlights = 1
OtherHeadlights = 0

; Player headlight color.
; Canonical palette:
;   Stock, White, Red, Green, Blue, Yellow, Cyan, Magenta,
;   Orange, Purple, Teal, Rainbow
; Stock aliases: Default, Off
; Custom RGB is also accepted as r,g,b; every component must be finite and
; within 0..20 inclusive, e.g. 5,2.5,1.
; Invalid/absent values fall back to Stock.
HeadlightColor = White

; Player headlight beam shape.
; Canonical:
;   Stock
;   Focused
;   Wide
; Accepted aliases:
;   Stock   : Default, Off
;   Focused : Focus, Narrow
; Invalid/absent values fall back to Stock.
HeadlightBeam = Wide



; Reveal an attacker's perceived team when it engages you, not only when its
; damage lands.
;
; Stock reveals an attacker only inside SetDamageFlags, which runs when a shot
; actually connects -- in both BZ 1.5 and Redux. An enemy that fires and misses
; therefore keeps whatever perceived team it was disguised with, so it can keep
; shooting at you while still reading as neutral or friendly on the satellite
; view and radar. This hooks the offensive/gun-tower/turret-tank attack paths
; and sets the attacker's perceivedTeam to its real team as it engages.
;
; NOTE: effective for the first time in this build. It previously wrote the
; actual-team field back over itself and always short-circuited, so it has
; never once run despite being enabled by default. If you see a behaviour
; change in enemy visibility after updating, this is the most likely cause --
; set it to 0 to get the previous (inert) behaviour back.
;
; Accepted: boolean. Default: ON.
; Trace: OPENSHIM_TRACE_ATTACK_REVEAL=1  (logs skip/noop/write per event)
; Legacy env alias to force it off: OPENSHIM_DISABLE_ATTACK_REVEAL
AttackRevealPerceivedTeam = 1
[Environment]

; ---------------------------------------------------------------------------
; Raw legacy / developer compatibility
; ---------------------------------------------------------------------------
; Any OPENSHIM_* or BZR_* variable not represented by a friendly key above can
; be supplied here verbatim. OpenShim checks this section before falling back to
; the real process environment. Prefer the first-class keys above for routine
; configuration; use this area for old launch-script compatibility and one-off
; reverse-engineering probes.
;
; Common raw-only examples (leave commented unless intentionally testing):
;
; Route forcing / migration:
; OPENSHIM_FORCE_PUBLIC_ROUTE = 1
; OPENSHIM_FORCE_RELAY_ROUTE = 1
; OPENSHIM_FORCE_P2P_ROUTE = 1
; OPENSHIM_FORCE_NET_INTERFACE = 192.168.1.10
; OPENSHIM_MIGRATE_NETWORK_INI = 1
;
; Shader-cache emergency opt-out:
; OPENSHIM_DISABLE_SHADER_CACHE = 1
; BZR_DISABLE_SHADER_CACHE = 1
;
; Terrain compatibility override retained for old scripts:
; OPENSHIM_TERRAIN_SEMANTIC_LEGACY_UV_QUANTIZATION = 0
;
; Older display-policy overrides are still understood by their legacy readers:
; OPENSHIM_UNDER_ATTACK_ALERT_MODE = Normal
; BZR_UNDER_ATTACK_ALERT_MODE = Normal
; OPENSHIM_DISABLE_UNDER_ATTACK_ALERT = 1
; BZR_DISABLE_UNDER_ATTACK_ALERT = 1
; OPENSHIM_UNDER_ATTACK_ALERT_COOLDOWN = 1.0
; BZR_UNDER_ATTACK_ALERT_COOLDOWN = 1.0
; OPENSHIM_UNDER_ATTACK_ALERT_COOLDOWN_SECONDS = 1.0
; OPENSHIM_TARGET_RETICLE_POPUP_MODE = Default
; BZR_TARGET_RETICLE_POPUP_MODE = Default
;
; Existing real process environment variables remain a final backward-
; compatibility fallback when no friendly/raw INI value supplies that name.
