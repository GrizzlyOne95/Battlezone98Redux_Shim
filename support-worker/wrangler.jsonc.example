{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openshim-support",
  "main": "src/index.js",
  "compatibility_date": "2026-09-04",
  "r2_buckets": [
    {
      "binding": "SUPPORT_BUCKET",
      "bucket_name": "openshim-support"
    }
  ],
  "vars": {
    "BETTERSTACK_INGEST_HOST": "https://REPLACE_WITH_SOURCE_INGEST_HOST"
  }
}
